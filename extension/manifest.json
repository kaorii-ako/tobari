{
  "manifest_version": 3,
  "name": "Tobari",
  "version": "0.1.0",
  "description": "Local-only AI assistant. Inference never leaves your machine.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Tobari" },
  "permissions": ["sidePanel", "contextMenus", "storage", "scripting", "activeTab", "alarms"]
}
