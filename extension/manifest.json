{
  "manifest_version": 3,
  "name": "Tobari",
  "version": "0.1.0",
  "description": "A browser that closes over the window. Local-only AI sidebar.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["sidePanel", "contextMenus", "activeTab", "scripting", "storage"],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Tobari",
    "default_icon": {
      "16": "icons/tobari-16.png",
      "48": "icons/tobari-48.png",
      "128": "icons/tobari-128.png"
    }
  },
  "icons": {
    "16": "icons/tobari-16.png",
    "48": "icons/tobari-48.png",
    "128": "icons/tobari-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self';"
  }
}
