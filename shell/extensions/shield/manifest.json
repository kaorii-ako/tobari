{
  "manifest_version": 3,
  "name": "Tobari",
  "description": "Controls Tobari's built-in network blocking. Bundled with the browser; talks only to the browser itself.",
  "version": "1.0.0",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tobari blocking",
    "default_icon": {
      "16": "icons/16.png",
      "24": "icons/24.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "bg.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "offscreen",
    "bookmarks",
    "history",
    "tabGroups",
    "storage"
  ],
  "host_permissions": [
    "https://tobari.internal/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
