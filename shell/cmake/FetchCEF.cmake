if(DEFINED CEF_ROOT AND EXISTS "${CEF_ROOT}/cmake/FindCEF.cmake")
  return()
endif()

set(CEF_INDEX_URL "https://cef-builds.spotifycdn.com/index.json")
set(CEF_LOCK "${CMAKE_SOURCE_DIR}/cef.lock")
set(CEF_ROOT_DIR "${CMAKE_SOURCE_DIR}/third_party")

if(NOT EXISTS "${CEF_LOCK}")
  file(DOWNLOAD "${CEF_INDEX_URL}" "${CMAKE_BINARY_DIR}/cef-index.json" STATUS st)
  list(GET st 0 code)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Could not fetch ${CEF_INDEX_URL}. Is cef-builds.spotifycdn.com reachable?")
  endif()
  file(READ "${CMAKE_BINARY_DIR}/cef-index.json" idx)
  string(JSON n LENGTH "${idx}" linux64 versions)
  math(EXPR last "${n} - 1")
  foreach(i RANGE 0 ${last})
    string(JSON channel GET "${idx}" linux64 versions ${i} channel)
    if(channel STREQUAL "stable")
      string(JSON ver GET "${idx}" linux64 versions ${i} cef_version)
      string(JSON nf LENGTH "${idx}" linux64 versions ${i} files)
      math(EXPR lastf "${nf} - 1")
      foreach(j RANGE 0 ${lastf})
        string(JSON type GET "${idx}" linux64 versions ${i} files ${j} type)
        if(type STREQUAL "minimal")
          string(JSON fname GET "${idx}" linux64 versions ${i} files ${j} name)
          string(JSON sha1 GET "${idx}" linux64 versions ${i} files ${j} sha1)
        endif()
      endforeach()
      break()
    endif()
  endforeach()
  if(NOT fname)
    message(FATAL_ERROR "No stable linux64 minimal CEF build in the index")
  endif()
  file(WRITE "${CEF_LOCK}" "${ver}\n${fname}\n${sha1}\n")
  message(STATUS "Pinned CEF ${ver} in cef.lock. Commit it.")
endif()

file(STRINGS "${CEF_LOCK}" lock)
list(GET lock 0 CEF_VERSION)
list(GET lock 1 CEF_FILE)
list(GET lock 2 CEF_SHA1)
string(REGEX REPLACE "\\.tar\\.bz2$" "" CEF_DIRNAME "${CEF_FILE}")
set(CEF_ROOT "${CEF_ROOT_DIR}/${CEF_DIRNAME}")

if(NOT EXISTS "${CEF_ROOT}/cmake/FindCEF.cmake")
  file(MAKE_DIRECTORY "${CEF_ROOT_DIR}")
  set(archive "${CEF_ROOT_DIR}/${CEF_FILE}")
  if(NOT EXISTS "${archive}")
    string(REPLACE "+" "%2B" enc "${CEF_FILE}")
    message(STATUS "Downloading ${CEF_FILE}")
    file(DOWNLOAD "https://cef-builds.spotifycdn.com/${enc}" "${archive}" EXPECTED_HASH SHA1=${CEF_SHA1} SHOW_PROGRESS)
  endif()
  file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${CEF_ROOT_DIR}")
endif()
